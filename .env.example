# Copy to .env and fill in the passwords created by sql/09_app_accounts.sql.
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_SERVER=localhost
DB_NAME=PetCareDB
DB_AUTH_USER=petcare_auth
DB_AUTH_PASSWORD=<petcare_auth password>
DB_CLERK_USER=petcare_clerk
DB_CLERK_PASSWORD=<petcare_clerk password>
DB_MANAGER_USER=petcare_manager
DB_MANAGER_PASSWORD=<petcare_manager password>
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=yes
DB_TIMEOUT=5
